{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "tech-lead",
    "subagent_depth": 1,
    "instructions": ["prompts/architecture.md", "prompts/conventions.md"],
    "permission": {
        "*": "allow",
        "bash": "allow",
        "task": "allow"
    },
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": ["php", "artisan", "boost:mcp"]
        },
        "codegraph": {
            "type": "local",
            "command": ["codegraph", "serve", "--mcp"],
            "enabled": true
        },
        "plantuml": {
            "type": "local",
            "command": ["npx", "-y", "@plantuml/mcp-js"],
            "enabled": true
        },
        "stitch": {
            "type": "remote",
            "url": "https://stitch.googleapis.com/mcp",
            "enabled": true,
            "headers": {
                "X-Goog-Api-Key": STITCH-API-KEY
            }
        }
    }
}
